{
  "name": "documentation-maker",
  "version": "1.0.0",
  "description": "An intelligent documentation generator for GitHub and Azure DevOps repositories",
  "main": "src/DocumentationMaker.js",
  "bin": {
    "doc-maker": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "docs": "node src/cli.js --url . --output ./docs"
  },
  "keywords": [
    "documentation",
    "code-analysis",
    "github",
    "azure-devops",
    "markdown",
    "html",
    "pdf",
    "cli"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.6",
    "marked": "^7.0.4",
    "ora": "^5.4.1",
    "puppeteer": "^21.1.1",
    "simple-git": "^3.19.1"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.20.6",
    "tree-sitter-c-sharp": "^0.20.0",
    "tree-sitter-go": "^0.20.0",
    "tree-sitter-java": "^0.20.2",
    "tree-sitter-javascript": "^0.20.4",
    "tree-sitter-python": "^0.20.4",
    "tree-sitter-rust": "^0.20.4",
    "tree-sitter-typescript": "^0.20.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.6.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/documentation-maker.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/documentation-maker/issues"
  },
  "homepage": "https://github.com/yourusername/documentation-maker#readme"
}
